server {
  listen 80;
  client_max_body_size 4m;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  location ~* ^/captcha(?:/|$) { return 404; }
  location /api/ {
    include /etc/nginx/forward.conf;
  }
  location = /api { return 308 /api/; }
  location / { add_header Cache-Control "no-store" always; try_files $uri $uri/ /index.html; }
}
