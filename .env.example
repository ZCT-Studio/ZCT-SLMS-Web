# 前端运行：宿主机监听端口
ZCT_SLMS_WEB_PORT=17316

# API 转发：proxy（代理）/ redirect（308 重定向）/ off（关闭）
ZCT_SLMS_WEB_FORWARD_MODE=proxy
# 代理目标：前端容器内部可访问的后端地址
ZCT_SLMS_WEB_PROXY_URL=http://host.docker.internal:17112
# 重定向目标：浏览器可直接访问的后端地址，仅 redirect 模式使用
ZCT_SLMS_WEB_REDIRECT_URL=http://localhost:17112

# 浏览器 API：留空使用同域 /api；分域部署填写后端 HTTPS 源地址
ZCT_SLMS_WEB_API_URL=

# 本地开发：Vite /api 代理目标
VITE_ZCT_SLMS_WEB_DEV_PROXY_URL=http://localhost:17112
# 构建配置：通常留空，Docker 优先使用上方运行时 API 配置
VITE_ZCT_SLMS_WEB_API_URL=
# Demo 部署路径：Pages CI 自动设置，通常无需修改
VITE_ZCT_SLMS_WEB_BASE_PATH=/

# Docker 构建：可替换为可访问的镜像或 npm 源
ZCT_SLMS_BUILD_NODE_IMAGE=node:22-alpine
ZCT_SLMS_BUILD_NGINX_IMAGE=nginx:alpine
ZCT_SLMS_BUILD_NPM_REGISTRY=https://registry.npmjs.org/
